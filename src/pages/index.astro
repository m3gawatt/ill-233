---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { filterJobs, getDepartments, getLocations, sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = getDepartments(jobs);
const locations = getLocations(jobs);
const visibleJobs = filterJobs(jobs);
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {visibleJobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        <section
          aria-labelledby="role-filters-heading"
          class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5"
        >
          <h3 id="role-filters-heading" class="text-lg font-semibold text-slate-100">
            Filter roles
          </h3>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <label for="department-filter" class="block text-sm font-medium text-slate-200">
                Department
              </label>
              <select
                id="department-filter"
                class="mt-2 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-400"
                data-testid="department-filter"
              >
                <option value="">All departments</option>
                {departments.map((department) => <option value={department}>{department}</option>)}
              </select>
            </div>
            <div>
              <label for="location-filter" class="block text-sm font-medium text-slate-200">
                Location
              </label>
              <select
                id="location-filter"
                class="mt-2 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-400"
                data-testid="location-filter"
              >
                <option value="">All locations</option>
                {locations.map((location) => <option value={location}>{location}</option>)}
              </select>
            </div>
          </div>
          <button
            type="button"
            class="mt-4 rounded-lg border border-slate-500 px-4 py-2 text-sm font-medium text-slate-100 transition hover:border-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400 disabled:cursor-not-allowed disabled:border-slate-700 disabled:text-slate-500"
            data-testid="filter-reset"
            disabled
          >
            Reset filters
          </button>
        </section>

        <div
          class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          data-testid="roles-grid"
        >
          {visibleJobs.map((job) => <RoleCard job={job} />)}
        </div>

        <div data-testid="filtered-empty-state" hidden aria-live="polite">
          <EmptyState text="No roles match those filters. Try a different department or location." />
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  const departmentFilter = document.querySelector<HTMLSelectElement>(
    '[data-testid="department-filter"]',
  );
  const locationFilter = document.querySelector<HTMLSelectElement>(
    '[data-testid="location-filter"]',
  );
  const resetButton = document.querySelector<HTMLButtonElement>(
    '[data-testid="filter-reset"]',
  );
  const filteredEmptyState = document.querySelector<HTMLElement>(
    '[data-testid="filtered-empty-state"]',
  );
  const roleCards = document.querySelectorAll<HTMLElement>('[data-testid="role-card"]');

  function updateVisibleRoles(): void {
    if (!departmentFilter || !locationFilter || !resetButton || !filteredEmptyState) {
      return;
    }

    const department = departmentFilter.value;
    const location = locationFilter.value;
    let matchingRoleCount = 0;

    for (const roleCard of roleCards) {
      const matches =
        (!department || roleCard.dataset.department === department) &&
        (!location || roleCard.dataset.location === location);

      roleCard.hidden = !matches;
      if (matches) {
        matchingRoleCount += 1;
      }
    }

    filteredEmptyState.hidden = matchingRoleCount !== 0;
    resetButton.disabled = !department && !location;
  }

  function resetFilters(): void {
    if (!departmentFilter || !locationFilter) {
      return;
    }

    departmentFilter.value = '';
    locationFilter.value = '';
    updateVisibleRoles();
  }

  departmentFilter?.addEventListener('change', updateVisibleRoles);
  locationFilter?.addEventListener('change', updateVisibleRoles);
  resetButton?.addEventListener('click', resetFilters);
</script>
